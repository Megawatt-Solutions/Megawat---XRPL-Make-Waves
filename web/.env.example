# ── Megawatt web app environment ─────────────────────────────────
# Copy to .env.local and fill in there.
#
# This file is COMMITTED. It is the one env file .gitignore deliberately
# un-ignores (`!**/.env.example`), so a real key placed here is a real
# key published to anyone with repo access. Values belong in .env.local,
# which is ignored.

# ── Required for Spreadcast ──────────────────────────────────────
# Without these the game refuses predictions rather than accepting
# unsigned ones — a pick is an on-chain commitment or it is nothing.

# Xaman (XUMM) app credentials — https://apps.xumm.dev
# Both sign-in (identity) and the daily commit signature go through these.
XUMM_API_KEY=
XUMM_API_SECRET=

# XRPL account that receives the daily 1-drop commit Payments and sends
# the weekly Merkle anchor. Address only — the seed stays with the CTO.
XRPL_ANCHOR_ADDRESS=

# Game API on the droplet (worker/index.mjs). Postgres is localhost-only
# there and is reached through bearer-token RPC.
SPREADCAST_API_URL=
SPREADCAST_API_TOKEN=

# HMAC key for the sc_session cookie. Any long random string:
#   openssl rand -hex 32
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────
# XRPL mainnet WebSocket override (defaults to wss://xrplcluster.com).
XRPL_WSS=

# Public origin of the deployed site, e.g. https://example.com
# Resolves og:image / twitter:image to absolute urls. Without it Next
# falls back to http://localhost:3000 and share previews render blank.
NEXT_PUBLIC_SITE_URL=

# PostHog. The same two variables serve both clients — the browser
# (instrumentation-client.ts) and posthog-node in the Spreadcast routes
# (src/lib/posthog-server.ts). Neither initialises unless both are set, and
# an uninitialised client drops events silently rather than queueing them.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Region host, and it means different things on each side. The browser reads
# it only to decide whether to init: it posts to the /ingest rewrites in
# next.config.ts, which point at eu.i.posthog.com, so its value cannot move
# where client events go. The server sends here directly. Set it to
# https://eu.i.posthog.com so the two halves land in one project — a US value
# splits server events off into a project the client never reaches.
NEXT_PUBLIC_POSTHOG_HOST=
